# ==============================================================================
# GearUp E-Commerce Production Environment Configuration Template
# Copy this file to .env on your deployment server: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DOMAINS & NETWORKING
# ------------------------------------------------------------------------------
# Frontend public domain (no trailing slash)
FRONTEND_URL=https://yourdomain.com

# API Gateway public base URL accessed by browsers
VITE_API_BASE=https://api.yourdomain.com

# Allowed CORS origins for API Gateway (comma-separated)
ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:5173

# ------------------------------------------------------------------------------
# 2. SECURITY SECRETS
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_super_secure_random_jwt_secret_key_32_chars
SESSION_SECRET=replace_with_a_super_secure_session_secret_key_32_chars

# Database root password
MYSQL_ROOT_PASSWORD=replace_with_a_strong_database_password

# ------------------------------------------------------------------------------
# 3. GOOGLE & FACEBOOK OAUTH (Optional for Social Login)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/auth/google/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://api.yourdomain.com/auth/facebook/callback

# ------------------------------------------------------------------------------
# 4. SMTP EMAIL (For sending OTP, password reset, and order confirmations)
# ------------------------------------------------------------------------------
# If using Gmail: create App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI (For AI PC Chatbot)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 6. VNPAY ONLINE PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Sandbox test credentials: https://sandbox.vnpayment.vn
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://yourdomain.com/payment/vnpay-return
